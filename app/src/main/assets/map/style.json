{
  "version": 8,
  "name": "SaveQuest Santiago hybrid",
  "sources": {
    "santiago": {
      "type": "vector",
      "url": "pmtiles://asset://map/santiago.pmtiles",
      "attribution": "© OpenStreetMap contributors · ODbL"
    },
    "movements": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "places": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "user-location": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#10131E"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "santiago",
      "filter": [
        "==",
        "kind",
        "park"
      ],
      "paint": {
        "fill-color": "#174B43",
        "fill-opacity": 0.8
      },
      "source-layer": "santiago"
    },
    {
      "id": "water",
      "type": "line",
      "source": "santiago",
      "filter": [
        "==",
        "kind",
        "water"
      ],
      "paint": {
        "line-color": "#3A8AA3",
        "line-width": 3
      },
      "source-layer": "santiago"
    },
    {
      "id": "roads",
      "type": "line",
      "source": "santiago",
      "filter": [
        "==",
        "kind",
        "road"
      ],
      "paint": {
        "line-color": "#55516F",
        "line-width": {
          "stops": [
            [
              10,
              0.6
            ],
            [
              14,
              2
            ],
            [
              18,
              7
            ]
          ]
        }
      },
      "source-layer": "santiago"
    },
    {
      "id": "main-roads",
      "type": "line",
      "source": "santiago",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "paint": {
        "line-color": "#A494DA",
        "line-width": {
          "stops": [
            [
              10,
              1
            ],
            [
              14,
              3
            ],
            [
              18,
              9
            ]
          ]
        }
      },
      "source-layer": "santiago"
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "santiago",
      "source-layer": "santiago",
      "minzoom": 15,
      "filter": [
        "all",
        [
          "==",
          "kind",
          "road"
        ],
        [
          "!=",
          "name",
          ""
        ],
        [
          "!in",
          "class",
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 250,
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              15,
              11
            ],
            [
              18,
              14
            ]
          ]
        },
        "text-max-angle": 35,
        "text-padding": 4,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#C8C3D8",
        "text-halo-color": "#10131E",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "major-road-labels",
      "type": "symbol",
      "source": "santiago",
      "source-layer": "santiago",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "==",
          "kind",
          "road"
        ],
        [
          "!=",
          "name",
          ""
        ],
        [
          "in",
          "class",
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": {
          "stops": [
            [
              11,
              11
            ],
            [
              15,
              13
            ],
            [
              18,
              15
            ]
          ]
        },
        "text-max-angle": 35,
        "text-padding": 4,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#E0D4FF",
        "text-halo-color": "#10131E",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "places-icons",
      "type": "symbol",
      "source": "places",
      "minzoom": 14,
      "layout": {
        "icon-image": [
          "concat",
          "poi-",
          [
            "get",
            "category"
          ]
        ],
        "icon-size": 1.0,
        "icon-allow-overlap": false,
        "icon-padding": 3,
        "text-field": [
          "step",
          [
            "zoom"
          ],
          "",
          15,
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-offset": [
          0,
          1.5
        ],
        "text-anchor": "top",
        "text-max-width": 11,
        "text-padding": 5,
        "text-optional": true,
        "icon-optional": false
      },
      "paint": {
        "text-color": "#F4EEFF",
        "text-halo-color": "#10131E",
        "text-halo-width": 2
      }
    },
    {
      "id": "movements",
      "type": "circle",
      "source": "movements",
      "paint": {
        "circle-radius": 8,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#FFFFFF",
        "circle-color": [
          "case",
          [
            "get",
            "expense"
          ],
          "#FF7F92",
          "#43DBAE"
        ]
      }
    },
    {
      "id": "user-location-halo",
      "type": "circle",
      "source": "user-location",
      "paint": {
        "circle-radius": 14,
        "circle-color": "#56E2B4",
        "circle-opacity": 0.18,
        "circle-stroke-color": "#56E2B4",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "user-location-hero",
      "type": "symbol",
      "source": "user-location",
      "layout": {
        "icon-image": "user-hero",
        "icon-size": 0.65,
        "icon-anchor": "bottom",
        "icon-allow-overlap": true,
        "icon-ignore-placement": true,
        "icon-pitch-alignment": "viewport"
      }
    }
  ],
  "glyphs": "asset://map/fonts/{fontstack}/{range}.pbf"
}
